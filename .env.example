NODE_ENV=development
PORT=3001
# Production: ≥32 random chars. Required when NODE_ENV=production.
JWT_SECRET=clinica-tanah-dev-secret-change-me-in-prod

# PHI field encryption (AES-256-GCM). Prefer a dedicated 32-byte key:
#   openssl rand -base64 32
# If omitted, the key is derived from JWT_SECRET (still encrypted at rest).
# PHI_ENCRYPTION_KEY=

# Comma-separated browser origins for CORS (production).
# APP_ORIGIN=https://clinica-tanah-bbqu7.ondigitalocean.app

# Only for demo/e2e: allow resetting Juliana password on boot.
# ALLOW_DEMO_PASSWORD_RESET=1
# ADMIN_BOOTSTRAP_PASSWORD=1234

# WhatsApp Business Cloud API (Meta) — all four are required for a real,
# verified production integration. Without them the bot runs in dry-run
# (simulator) mode and no message leaves the server.
#
# Permanent token for a system user with whatsapp_business_messaging:
# META_WA_TOKEN=your_meta_whatsapp_business_api_token
# Phone number ID from Meta App > WhatsApp > API Setup:
# META_WA_PHONE_ID=your_phone_number_id
# Token Meta sends on GET /api/whatsapp/webhook verification:
# META_WA_VERIFY_TOKEN=clinica-tanah-verify
# App secret (Meta App > Settings > Basic) — enables X-Hub-Signature-256
# verification of every incoming webhook payload:
# META_WA_APP_SECRET=your_meta_app_secret


# NVIDIA NIM (build.nvidia.com) — free vision OCR for invoice document upload.
# Comma-separated keys are rotated on rate limits. Never commit real keys.
# NVIDIA_API_KEYS=nvapi-xxx,nvapi-yyy
# NVIDIA_OCR_MODEL=nvidia/nemotron-nano-12b-v2-vl
# Temporary PIN required to delete unpaid invoices (default 1234)
# INVOICE_DELETE_PASSWORD=1234
# UPLOADS_DIR=./data/uploads

# LGPD / DPO (shown on /privacidade and staff LGPD module)
DPO_NAME=Juliana
DPO_EMAIL=dpo@clinica-tanah.com.br
DPO_PHONE=+55 11 3000-0001
CLINIC_NAME=Clínica Tanah
LGPD_POLICY_VERSION=1.2

# Body composition image generation (Corpo / scenarios)
# A2E_ENABLED=1
# A2E_API_KEY=
# A2E_MODEL=nano-banana-pro
# A2E_IMAGE_SIZE=4K
# GEMINI_ENABLED=1
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-image
# BITDEER_API_KEY=
# BITDEER_BASE_URL=
# BITDEER_API_STYLE=openai   # or gemini for flash-image proxy
# BITDEER_MODEL=google/flash-image-2.5
# LOCAL_MORPH_FALLBACK=1     # default on; set 0 to disable
# IMAGE_PROVIDER_ORDER=a2e,gemini,bitdeer,local_morph
